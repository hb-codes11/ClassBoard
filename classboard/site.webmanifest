{
  "name": "ClassBoard — Class Portal",
  "short_name": "ClassBoard",
  "description": "Class portal for multiple class sections",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#f4f8fc",
  "theme_color": "#006BFF",
  "icons": [
    {
      "src": "./classboard-pwa-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./classboard-pwa-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./classboard-pwa-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "scope": "./",
  "display_override": [
    "standalone",
    "minimal-ui"
  ]
}
